<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde Android : données du joueur (préférences, progression, builds, notes, corrections) incluses ;
     la base de contenu, réinstallée avec l’APK, n’est pas incluse. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
        <include domain="database" path="user.db" />
        <include domain="database" path="user.db-wal" />
        <include domain="database" path="user.db-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
        <include domain="database" path="user.db" />
        <include domain="database" path="user.db-wal" />
        <include domain="database" path="user.db-shm" />
    </device-transfer>
</data-extraction-rules>
